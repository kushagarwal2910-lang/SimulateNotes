# OpenRouter API Key Pool
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional additional keys for round-robin rotation
OPENROUTER_API_KEY_1=your_openrouter_api_key_1
OPENROUTER_API_KEY_2=your_openrouter_api_key_2
OPENROUTER_API_KEY_3=your_openrouter_api_key_3

# Tavily API Key for Web Research (fetches 25-30 authoritative documents)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Model to use on OpenRouter for simulation code generation
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# High-context model to use for dense JSON specification synthesis
RAG_SPEC_MODEL=google/gemini-2.0-flash-001

# Maximum self-healing iterations for LangGraph code verification
MAX_VERIFICATION_ITERATIONS=2

